{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rogerchappel/runfreeze/blob/main/schemas/evidence-report.schema.json",
  "title": "runfreeze schema-1 evidence report",
  "description": "Structural schema for runfreeze JSON reports. Cross-field summary and redaction totals are additionally checked by `runfreeze verify`.",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "type": "object", "additionalProperties": false, "properties": { "name": { "const": "runfreeze" }, "version": { "type": "string" } }, "required": ["name", "version"] },
    "root": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "summary": { "type": "object", "additionalProperties": false, "properties": { "total": { "$ref": "#/$defs/count" }, "passed": { "$ref": "#/$defs/count" }, "failed": { "$ref": "#/$defs/count" }, "redactions": { "$ref": "#/$defs/count" }, "truncated": { "$ref": "#/$defs/count" } }, "required": ["total", "passed", "failed", "redactions", "truncated"] }
  },
  "required": ["schemaVersion", "tool", "root", "createdAt", "commands", "summary"],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "command": { "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "cwd": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" }, "endedAt": { "type": "string", "format": "date-time" }, "durationMs": { "$ref": "#/$defs/count" },
        "exitCode": { "type": ["integer", "null"] }, "signal": { "type": ["string", "null"] }, "timedOut": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/stream" }, "stderr": { "$ref": "#/$defs/stream" }, "redactions": { "$ref": "#/$defs/redactions" }, "allowedFailure": { "type": "boolean" }
      }, "required": ["id", "command", "cwd", "startedAt", "endedAt", "durationMs", "exitCode", "signal", "timedOut", "stdout", "stderr", "redactions", "allowedFailure"]
    },
    "stream": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string" }, "bytes": { "$ref": "#/$defs/count" }, "truncated": { "type": "boolean" } }, "required": ["text", "bytes", "truncated"] },
    "redactions": { "type": "object", "additionalProperties": false, "properties": { "total": { "$ref": "#/$defs/count" }, "byPattern": { "type": "object", "additionalProperties": { "$ref": "#/$defs/count" } } }, "required": ["total", "byPattern"] }
  }
}
